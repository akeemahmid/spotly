# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
!.env.isolated-browser.example
.spotly-security-storage.json

# Private recovery archives, diagnostics and credential files
.spotly-security-*
*.key
*.p12
*.pfx
# Owner-requested local support attachment; never include in a release.
/docs/spotly-storage-support-attachment.txt
