# Server only. Never prefix with NEXT_PUBLIC_ or commit a real key.
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Public project credentials only. Never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only HMAC key: exactly 64 hex characters, matching spotly_private.serv_plan_key.
# Provision securely; never commit a real key or prefix it with NEXT_PUBLIC_.
SERV_PLAN_SIGNING_KEY=

# Server workflow gate. Leave false until signing and dedicated-account checks pass.
# The private database workflow_gate must also be enabled by its owner.
PHASE3B_ENABLED=false
